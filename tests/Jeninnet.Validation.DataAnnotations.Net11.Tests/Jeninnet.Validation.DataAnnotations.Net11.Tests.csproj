<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <DisableArtifacts>true</DisableArtifacts>
        <AssemblyName>Jeninnet.Validation.DataAnnotations.Net11.Tests</AssemblyName>
        <RootNamespace>Jeninnet.Validation.DataAnnotations.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\Jeninnet.Validation.DataAnnotations.Tests\**\*.cs"
                 Exclude="..\Jeninnet.Validation.DataAnnotations.Tests\bin\**;..\Jeninnet.Validation.DataAnnotations.Tests\obj\**"
                 LinkBase="Linked" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="MSTest" />
        <PackageReference Include="MSTest.TestAdapter" />
        <PackageReference Include="coverlet.collector" PrivateAssets="all" />
        <PackageReference Include="Jeninnet.Assertions" />
        <PackageReference Include="Jeninnet.Assertions.MSTest" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Jeninnet.Validation.DataAnnotations\Jeninnet.Validation.DataAnnotations.csproj" />
        <ProjectReference Include="..\..\src\Jeninnet.Validation\Jeninnet.Validation.csproj" />
        <ProjectReference Include="..\..\src\Jeninnet.Validation.Abstractions\Jeninnet.Validation.Abstractions.csproj" />
    </ItemGroup>

</Project>
