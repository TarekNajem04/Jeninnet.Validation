<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <AssemblyName>Jeninnet.Validation.OpenApi.Swashbuckle</AssemblyName>
        <RootNamespace>Jeninnet.Validation.OpenApi.Swashbuckle</RootNamespace>
        <Description>Swashbuckle schema filter that applies Jeninnet.Validation constraints to generated OpenAPI schemas.</Description>
    </PropertyGroup>

    <Import Project="..\shared\OpenApi\OpenApi.projitems" />

    <ItemGroup>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jeninnet.Validation.Abstractions\Jeninnet.Validation.Abstractions.csproj" />
        <ProjectReference Include="..\Jeninnet.Validation.JsonSchema\Jeninnet.Validation.JsonSchema.csproj" />
        <ProjectReference Include="..\Jeninnet.Validation.OpenApi\Jeninnet.Validation.OpenApi.csproj" />
    </ItemGroup>

</Project>
