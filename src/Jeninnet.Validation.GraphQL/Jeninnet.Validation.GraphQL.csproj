<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <AssemblyName>Jeninnet.Validation.GraphQL</AssemblyName>
        <RootNamespace>Jeninnet.Validation.GraphQL</RootNamespace>
        <Description>HotChocolate GraphQL field middleware that validates input objects with Jeninnet.Validation.</Description>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="HotChocolate.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jeninnet.Validation\Jeninnet.Validation.csproj" />
        <ProjectReference Include="..\Jeninnet.Validation.Abstractions\Jeninnet.Validation.Abstractions.csproj" />
    </ItemGroup>

</Project>
