<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <AssemblyName>Jeninnet.Validation.AspNetCore</AssemblyName>
        <RootNamespace>Jeninnet.Validation.AspNetCore</RootNamespace>
        <Description>ASP.NET Core integration for Jeninnet.Validation (minimal API endpoint filter and MVC auto-validation).</Description>
        <NoWarn>$(NoWarn);NU5104</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Jeninnet.Validation.AspNetCore.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Jeninnet.Localization.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jeninnet.Validation\Jeninnet.Validation.csproj" />
        <ProjectReference Include="..\Jeninnet.Validation.Abstractions\Jeninnet.Validation.Abstractions.csproj" />
    </ItemGroup>

</Project>
