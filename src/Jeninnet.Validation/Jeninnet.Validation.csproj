<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Package Version Strategy
        1.0.0  initial release
        1.2.0  new features
        1.1.1  bug fix
        2.0.0  breaking change        
    -->
    <PropertyGroup>
        <!-- 
          DisableGlobalFramework:
          This flag allows a project to opt out of the default TargetFramework 
          defined in Directory.Build.props. Our solution sets a global framework 
          (e.g., net10.0) for most projects, but some libraries—such as analyzers, 
          generators, or multi-targeted runtime components—need to define their own 
          TargetFrameworks without being overridden by the global setting.

          Setting <DisableGlobalFramework>true</DisableGlobalFramework> tells the 
          Directory.Build.props file: “Do not apply the global TargetFramework to 
          this project; let this project control its own frameworks.”
        -->
        <DisableGlobalFramework>false</DisableGlobalFramework>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <AssemblyName>Jeninnet.Validation</AssemblyName>
        <RootNamespace>Jeninnet.Validation</RootNamespace>
        <Description>Core validation engine for the Jeninnet validation ecosystem.</Description>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <Import Project="..\shared\Rules\Rules.projitems" Label="Shared" />

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jeninnet.Validation.Abstractions\Jeninnet.Validation.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Jeninnet.Validation.Analyzers.Tests" />
        <InternalsVisibleTo Include="Jeninnet.Validation.Benchmarks" />
        <InternalsVisibleTo Include="Jeninnet.Validation.Tests" />
    </ItemGroup>

</Project>
