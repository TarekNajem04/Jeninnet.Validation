<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework></TargetFramework>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <AssemblyName>Jeninnet.Validation.OpenApi</AssemblyName>
        <RootNamespace>Jeninnet.Validation.OpenApi</RootNamespace>
        <Description>OpenAPI schema constraints generated from Jeninnet.Validation descriptors.</Description>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.OpenApi" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jeninnet.Validation.Abstractions\Jeninnet.Validation.Abstractions.csproj" />
        <ProjectReference Include="..\Jeninnet.Validation.JsonSchema\Jeninnet.Validation.JsonSchema.csproj" />
    </ItemGroup>

</Project>
