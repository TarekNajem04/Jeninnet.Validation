    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jeninnet.Validation\Jeninnet.Validation.csproj" />
        <ProjectReference Include="..\Jeninnet.Validation.Abstractions\Jeninnet.Validation.Abstractions.csproj" />
        <ProjectReference Include="..\Jeninnet.Validation.Localization\Jeninnet.Validation.Localization.csproj" />
        <ProjectReference Include="..\Jeninnet.Validation.Analyzers\Jeninnet.Validation.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <PropertyGroup>
        <DisableArtifacts>true</DisableArtifacts>
    </PropertyGroup>
</Project>
