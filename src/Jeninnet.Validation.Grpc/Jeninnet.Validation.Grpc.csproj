<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <AssemblyName>Jeninnet.Validation.Grpc</AssemblyName>
        <RootNamespace>Jeninnet.Validation.Grpc</RootNamespace>
        <Description>gRPC server interceptor that validates request messages with Jeninnet.Validation.</Description>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Google.Api.CommonProtos" />
        <PackageReference Include="Grpc.AspNetCore.Server" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jeninnet.Validation.Abstractions\Jeninnet.Validation.Abstractions.csproj" />
    </ItemGroup>

</Project>
