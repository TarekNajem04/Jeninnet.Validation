<Project>

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <!-- The runtime support matrix; the first release targets .NET 11 (STS). -->
        <RuntimeTargetFrameworks>net11.0</RuntimeTargetFrameworks>
        <LangVersion>15.0</LangVersion>
        <!--<OutputPath>$(SolutionDir)output</OutputPath>-->

        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>
        <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!--
          https://www.tabsoverspaces.com/233608-stopping-msbuild-appending-targetframework-to-outputpath
          Stopping MSBuild appending TargetFramework to OutputPath
        -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

        <!--
        Utilize the documentation file in Open Api. The SDK writes it to the output
        directory, so generated XML does not pollute the source tree.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SonarAnalyzer.CSharp">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.SourceLink.GitHub">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- SourceLink runs only in CI: local clones may lack the git remote, and its
         "no remote / empty source link" warnings must not pollute local builds.
         The publish workflow always runs with CI=true. -->
    <PropertyGroup>
        <EnableSourceLink Condition="'$(CI)' != 'true'">false</EnableSourceLink>
    </PropertyGroup>

    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>recommended</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <PropertyGroup Condition="'$(CI)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <Authors>Tarek Najem</Authors>
        <Copyright>Copyright © Jeninnet</Copyright>
        <NeutralLanguage>en</NeutralLanguage>
        <Description>$(MSBuildProjectName) - a component of Jeninnet.Validation, a modular .NET validation framework with fluent and attribute authoring, source generation, AOT support, zero-allocation execution, and ASP.NET Core, Blazor, MediatR, OpenAPI, JSON Schema, and GraphQL integrations.</Description>
        <PackageTags>validation;model-validation;fluent-validation;data-annotations;aspnetcore;blazor;source-generator;csharp;dotnet;net11</PackageTags>

        <!--
            Single solution-wide product version (the project identity rule).
            Projects must NOT declare their own <Version>.
            AssemblyVersion and FileVersion must stay numeric because they cannot carry a prerelease label.
        -->
        <Version>1.0.0-preview.1</Version>
        <FileVersion>1.0.0.0</FileVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <PackageVersion>$(Version)</PackageVersion>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>jeninnet-validation-icon-128.png</PackageIcon>
        <PackageId>$(MSBuildProjectName)</PackageId>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/TarekNajem04/Jeninnet.Validation.git</RepositoryUrl>
        <PackageProjectUrl>https://github.com/TarekNajem04/Jeninnet.Validation</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <PackageReleaseNotes>See CHANGELOG.md at https://github.com/TarekNajem04/Jeninnet.Validation</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <!-- Set the minimum NuGet client version required to install this package -->
        <MinClientVersion>7.3.0</MinClientVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')" Include="$(MSBuildThisFileDirectory)LICENSE">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Condition="Exists('$(MSBuildProjectDirectory)\README.md')" Include="$(MSBuildProjectDirectory)\README.md">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="$(MSBuildThisFileDirectory)assets/jeninnet-validation-icon-128.png">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <!--
        <None Include="$(SolutionDir)output\**\*">
            <Link>output\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <Pack>false</Pack>
            <Visible>true</Visible>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
        -->

    </ItemGroup>

    <!--
    https://learn.microsoft.com/en-us/dotnet/csharp/language-reference/compiler-options/errors-warnings#warninglevel
    WarningLevel
    The WarningLevel option specifies the warning level for the compiler to display.
    ===========================================================================================================================================================
    ‖ Warning level	‖ Meaning                                                                                                                                 ‖
    ===========================================================================================================================================================
    ‖ 0	            ‖ Turns off emission of all warning messages.                                                                                             ‖
    ‖ 1	            ‖ Displays severe warning messages.                                                                                                       ‖
    ‖ 2	            ‖ Displays level 2 warnings plus certain, less-severe warnings, such as warnings about hiding class members.                              ‖
    ‖ 3	            ‖ Displays level 2 warnings plus certain, less-severe warnings, such as warnings about expressions that always evaluate to true or false. ‖
    ‖ 4 (default)	‖ Displays all level 3 warnings plus informational warnings.                                                                              ‖
    ===========================================================================================================================================================
    -->
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <WarningLevel>9999</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <WarningLevel>9999</WarningLevel>
    </PropertyGroup>

    <!--
        We don't follow Arcade conventions for project naming.
    -->
    <PropertyGroup Condition="'$(IsUnitTestProject)' == ''">
        <IsUnitTestProject>false</IsUnitTestProject>
        <IsUnitTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsUnitTestProject>
        <!-- Ensure this line copies the test result files to a unified folder in the root of the Solution -->
        <VSTestResultsDirectory>$(MSBuildThisFileDirectory)TestResults</VSTestResultsDirectory>
    </PropertyGroup>

    <PropertyGroup>
        <IsSampleProject Condition="$(MSBuildProjectName.Contains('.Sample.'))">true</IsSampleProject>
        <IsNonShippingProject Condition="$(MSBuildProjectName.EndsWith('.Benchmarks'))">true</IsNonShippingProject>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn Condition="'$(IsUnitTestProject)' == 'true' Or '$(IsSampleProject)' == 'true' Or '$(IsNonShippingProject)' == 'true'">$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <!-- Local NuGet feed for analyzer package -->
    <PropertyGroup>
        <!-- Where the local feed lives (relative to solution root) -->
        <LocalArtifacts>$(MSBuildThisFileDirectory)artifacts\</LocalArtifacts>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DisableArtifacts)' != 'true'">
        <!-- Add local feed as an extra restore source -->
        <!--<RestoreSources>$(RestoreSources);$(LocalArtifacts)</RestoreSources>-->
    </PropertyGroup>

</Project>
