{
    "name": "@jeninnet/validation-client",
    "version": "1.0.0-preview.1",
    "description": "Dependency-free browser-side evaluator for Jeninnet.Validation client rules.",
    "type": "module",
    "main": "./src/client-validator.js",
    "types": "./src/client-validator.d.ts",
    "exports": {
        ".": {
            "types": "./src/client-validator.d.ts",
            "import": "./src/client-validator.js"
        },
        "./messages": {
            "types": "./src/messages.d.ts",
            "import": "./src/messages.js"
        },
        "./unobtrusive": {
            "types": "./src/jeninnet-unobtrusive.d.ts",
            "import": "./src/jeninnet-unobtrusive.js"
        }
    },
    "files": [
        "src"
    ],
    "scripts": {
        "test": "node --test",
        "check": "node --test"
    },
    "engines": {
        "node": ">=20"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TarekNajem04/Jeninnet.Validation"
    }
}
